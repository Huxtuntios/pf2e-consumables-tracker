<div class="pct-panel {{#if filters.compact}}pct-compact{{/if}}">
<div class="pct-toolbar">
  {{#if isGM}}<p class="pct-combat-hint">{{localize "pf2e-consumables-tracker.CombatHint"}}</p>{{/if}}
  <div class="pct-toolbar-row">
    <label class="pct-field">
      <span>{{localize "pf2e-consumables-tracker.Labels.View"}}</span>
      <select data-filter="viewMode">
        {{#each viewModes}}
          <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
        {{/each}}
      </select>
    </label>

    {{#if showPlayerSelect}}
      <label class="pct-field">
        <span>{{localize "pf2e-consumables-tracker.Labels.Player"}}</span>
        <select data-filter="userId">
          {{#each playerChoices}}
            <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.name}}</option>
          {{/each}}
        </select>
      </label>
    {{/if}}

    {{#if showCharacterSelect}}
      <label class="pct-field">
        <span>{{localize "pf2e-consumables-tracker.Labels.Character"}}</span>
        <select data-filter="actorId">
          {{#each characterChoices}}
            <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.name}}</option>
          {{/each}}
        </select>
      </label>
    {{/if}}

    {{#if isGM}}
      <label class="pct-checkbox pct-side-toggle pct-side-ally"><input type="checkbox" data-filter="showAllies" {{#if filters.showAllies}}checked{{/if}} /> <i class="fa-solid fa-handshake"></i> {{localize "pf2e-consumables-tracker.Allies"}}</label>
      <label class="pct-checkbox pct-side-toggle pct-side-enemy"><input type="checkbox" data-filter="showEnemies" {{#if filters.showEnemies}}checked{{/if}} /> <i class="fa-solid fa-skull"></i> {{localize "pf2e-consumables-tracker.Enemies"}}</label>
      <button type="button" class="pct-blacklist-btn" data-action="openBlacklist">
        <i class="fa-solid fa-ban"></i> {{localize "pf2e-consumables-tracker.Settings.BlacklistMenu.Label"}}
      </button>
    {{/if}}
  </div>

  <div class="pct-toolbar-row">
    <label class="pct-field">
      <span>{{localize "pf2e-consumables-tracker.Labels.GroupBy"}}</span>
      <select data-filter="groupBy">
        {{#each groupByChoices}}
          <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
        {{/each}}
      </select>
    </label>

    <label class="pct-field">
      <span>{{localize "pf2e-consumables-tracker.Labels.SortBy"}}</span>
      <select data-filter="sortBy">
        {{#each sortByChoices}}
          <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
        {{/each}}
      </select>
    </label>

    <button type="button" class="pct-sort-dir-btn" data-action="toggleSortDir"
            title="{{#if (pctEq sortDir 'asc')}}{{localize 'pf2e-consumables-tracker.SortDirAsc'}}{{else}}{{localize 'pf2e-consumables-tracker.SortDirDesc'}}{{/if}}">
      {{#if (pctEq sortDir "asc")}}
        <i class="fa-solid fa-arrow-down-short-wide"></i>
      {{else}}
        <i class="fa-solid fa-arrow-up-wide-short"></i>
      {{/if}}
    </button>

    <label class="pct-field pct-search-field">
      <span>{{localize "pf2e-consumables-tracker.Labels.Search"}}</span>
      <input type="text" data-filter="search" value="{{search}}"
             placeholder="{{localize 'pf2e-consumables-tracker.SearchPlaceholder'}}" />
    </label>

    <button type="button" class="pct-refresh-btn" data-action="refresh"
            title="{{localize 'pf2e-consumables-tracker.Refresh'}}">
      <i class="fa-solid fa-rotate"></i>
    </button>
  </div>

  <div class="pct-toolbar-row pct-quick-filters">
    <label class="pct-field"><span>{{localize "pf2e-consumables-tracker.QuickCategory"}}</span>
      <select data-filter="category"><option value="">{{localize "pf2e-consumables-tracker.All"}}</option>{{#each categoryChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
    <label class="pct-field"><span>{{localize "pf2e-consumables-tracker.QuickCharacter"}}</span>
      <select data-filter="character"><option value="">{{localize "pf2e-consumables-tracker.All"}}</option>{{#each quickCharacterChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
    <label class="pct-field"><span>{{localize "pf2e-consumables-tracker.QuickSide"}}</span>
      <select data-filter="side"><option value="">{{localize "pf2e-consumables-tracker.All"}}</option>{{#each sideChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
    <label class="pct-checkbox"><input type="checkbox" data-filter="compact" {{#if filters.compact}}checked{{/if}} /> {{localize "pf2e-consumables-tracker.Compact"}}</label>
  </div>

  {{#if showRecipientSelect}}
  <label class="pct-field"><span>{{localize "pf2e-consumables-tracker.Recipient"}}</span>
    <select data-filter="recipientId">{{#each recipientChoices}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select>
  </label>
  {{/if}}
  <div class="pct-total-count">
    {{totalText}}
  </div>
</div>

{{#if shareError}}<p class="pct-share-warning">{{localize "pf2e-consumables-tracker.ShareUnavailable"}}</p>{{/if}}
<div class="pct-body">
  {{#if hasResults}}
    {{#each groups}}
      <section class="pct-group">
        {{#if ../showGroupHeaders}}<details data-group-type="{{../filters.groupBy}}" data-group-key="{{this.key}}" {{#unless this.collapsed}}open{{/unless}}><summary class="pct-group-header">
          {{this.label}} <span class="pct-group-count">{{this.count}}</span>
        </summary>{{/if}}

        <ul class="pct-item-list">
          {{#each this.items}}
            <li class="pct-item-row pct-row-{{this.side}} {{#if this.empty}}pct-item-empty{{/if}}">
              {{#if this.canOpen}}<img class="pct-item-img" data-action="openItem" data-uuid="{{this.uuid}}" src="{{this.img}}" alt="{{this.name}}" />{{else}}<img class="pct-item-img" src="{{this.img}}" alt="{{this.name}}" />{{/if}}
              <div class="pct-item-main">
                <div class="pct-item-name-line">
                  {{#if this.canOpen}}<a class="pct-item-name" data-action="openItem" data-uuid="{{this.uuid}}" title="{{this.name}}">{{this.name}}</a>{{else}}<span class="pct-item-name" title="{{this.name}}">{{this.name}}</span>{{/if}}
                  {{#if this.unidentified}}<span class="pct-unidentified" title="{{localize 'pf2e-consumables-tracker.Unidentified'}}"><i class="fa-solid fa-eye-slash"></i> {{localize "pf2e-consumables-tracker.Unidentified"}}</span>{{/if}}
                  {{#unless (pctEq this.quantity 1)}}
                    <span class="pct-item-quantity">&times;{{this.quantity}}</span>
                  {{/unless}}
                </div>
                <div class="pct-item-meta-line">
                  <span class="pct-item-level" title="{{localize 'pf2e-consumables-tracker.Level'}}">
                    {{localize "pf2e-consumables-tracker.Level"}} {{this.level}}
                  </span>
                  <span class="pct-item-rarity pct-rarity-{{this.rarity}}">{{this.rarity}}</span>
                  <span class="pct-side-badge pct-side-{{this.side}}" title="{{this.sideLabel}}"><i class="{{this.sideIcon}}"></i> {{this.sideLabel}}</span>
                  <span class="pct-item-owner">{{this.actorName}}</span>
                  {{#if this.charges}}<span class="pct-charges">{{localize "pf2e-consumables-tracker.Charges"}}: {{this.charges.value}}/{{this.charges.max}}</span>{{/if}}
                  {{#if this.inContainer}}<span class="pct-container" title="{{localize 'pf2e-consumables-tracker.InContainer'}}{{#if this.containerName}}: {{this.containerName}}{{/if}}"><i class="fa-solid fa-box"></i> {{#if this.containerName}}{{this.containerName}}{{else}}{{localize "pf2e-consumables-tracker.InContainer"}}{{/if}}</span>{{/if}}
                </div>
                {{#if this.traits.length}}
                  <div class="pct-item-traits">
                    {{#each this.traits}}
                      <span class="pct-trait-tag">{{this}}</span>
                    {{/each}}
                  </div>
                {{/if}}
              </div>
              {{#if this.canUse}}<button type="button" class="pct-use-btn" data-action="useItem" data-uuid="{{this.uuid}}" title="{{#if this.useDisabled}}{{localize 'pf2e-consumables-tracker.UseEmpty'}}{{else}}{{this.useTitle}}{{/if}}" {{#if this.useDisabled}}disabled{{/if}}><i class="fa-solid fa-play"></i> {{localize "pf2e-consumables-tracker.Use"}}</button>{{/if}}
              {{#if this.canRequest}}<button type="button" class="pct-request-btn" data-action="requestItem" data-uuid="{{this.uuid}}" title="{{localize 'pf2e-consumables-tracker.Request'}}"><i class="fa-solid fa-hand"></i> {{localize "pf2e-consumables-tracker.Request"}}</button>{{/if}}
            </li>
          {{/each}}
        </ul>
        {{#if ../showGroupHeaders}}</details>{{/if}}
      </section>
    {{/each}}
  {{else}}
    <p class="pct-empty-state">{{localize "pf2e-consumables-tracker.EmptyState"}}</p>
  {{/if}}
</div>
</div>
